<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Adsefid.Sdk</RootNamespace>
    <AssemblyName>Adsefid.Sdk</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Adsefid.Sdk</PackageId>
    <Version>0.3.0</Version>
    <Description>A .NET client SDK for the adsefid.com SMS Web Service REST API: SMS, Messenger and User endpoints, plus outgoing webhook signature verification.</Description>
    <Authors>adsefid.com</Authors>
    <PackageTags>adsefid;sms;messenger;webservice;sdk</PackageTags>
    <RepositoryUrl>https://github.com/adsefid/sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/adsefid/sdk-dotnet</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public types and members that carry behaviour are documented; plain wire-shaped model
         properties named after their JSON field are not, by design. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
